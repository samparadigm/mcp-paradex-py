# Server Configuration
SERVER_NAME=Paradex Trading
SERVER_PORT=3000

# Paradex Configuration
# Options: testnet, mainnet
PARADEX_ENVIRONMENT=testnet

# Authentication — choose one of four modes:

# Mode 1: Private key (original mode)
PARADEX_ACCOUNT_PRIVATE_KEY=

# Mode 2: Static JWT token (from Paradex SIWE login, for non-HTTP deployments)
PARADEX_JWT_TOKEN=

# Mode 3: OAuth 2.1 Resource Server (HTTP transport only)
# Canonical URL of this MCP server (returned in /.well-known/oauth-protected-resource)
MCP_SERVER_URL=
# OAuth Authorization Server URL (e.g. https://api.prod.paradex.trade)
PARADEX_AUTH_SERVER_URL=

# Mode 4: Signer mode. A signing proxy holds the key; set all four and no private key.
# The server sends each message hash, base64, in PARADEX_SIGNER_HEADER, and sends
# PARADEX_SIGNER_SIGNATURE as the signature for the proxy to replace.
# Route requests through the proxy with HTTPS_PROXY (NO_PROXY and SSL_CERT_FILE also apply).
PARADEX_SIGNER_HEADER=
PARADEX_SIGNER_SIGNATURE=
PARADEX_ACCOUNT_ADDRESS=
PARADEX_ACCOUNT_PUBLIC_KEY=
